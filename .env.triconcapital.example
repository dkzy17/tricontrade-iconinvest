# TRICON CAPITAL GROUP deployment example.
# All credentials and resources must be independent from TriconTrade.

APP_NAME=Tricon Capital Group API
COMPANY_NAME=Tricon Capital Group
COMPANY_TAGLINE=Investment services
SERVICE_NAME=triconcapital-api

APP_URL=https://triconcapitalgroup.com
API_URL=https://api.triconcapitalgroup.com
UNSUBSCRIBE_URL=https://triconcapitalgroup.com/unsubscribe

DATABASE_URL=postgresql+asyncpg://TRICONCAPITAL_DB_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@DB_HOST:5432/triconcapital_prod
JWT_SECRET=REPLACE_WITH_A_NEW_UNIQUE_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# Add the admin frontend origin when its hostname is confirmed.
CORS_ORIGINS=["https://triconcapitalgroup.com","https://www.triconcapitalgroup.com"]

RESEND_API_KEY=REPLACE_WITH_TRICONCAPITAL_RESEND_API_KEY
# Use only after this sender domain has been verified with Resend.
EMAIL_FROM=no-reply@triconcapitalgroup.com

# Set independent administrator credentials before running the bootstrap script.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_SUPERADMIN_EMAIL=
# INITIAL_SUPERADMIN_PASSWORD=
