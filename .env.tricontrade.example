# TRICONTRADE deployment example.
# Copy the existing live .env to a protected .env.tricontrade file for production.
# Do not use these placeholders as production credentials.

APP_NAME=TriconTrade API
COMPANY_NAME=TriconTrade
COMPANY_TAGLINE=Secure Trading & Investment
SERVICE_NAME=tricontrade-fastapi

APP_URL=https://tricontrade.com
API_URL=https://api.tricontrade.com
UNSUBSCRIBE_URL=https://tricontrade.com/unsubscribe

DATABASE_URL=postgresql+asyncpg://TRICONTRADE_DB_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@DB_HOST:5432/TRICONTRADE_DATABASE
JWT_SECRET=REPLACE_WITH_THE_EXISTING_UNIQUE_TRICONTRADE_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

CORS_ORIGINS=["http://localhost:3000","http://localhost:3003","https://tricontrade.com","https://www.tricontrade.com","https://admin.tricontrade.com","https://tricontrade-admin.vercel.app"]

RESEND_API_KEY=REPLACE_WITH_TRICONTRADE_RESEND_API_KEY
EMAIL_FROM=no-reply@noreply.tricontrade.com

# Optional. Set the intended administrator credentials before running the bootstrap script.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_SUPERADMIN_EMAIL=
# INITIAL_SUPERADMIN_PASSWORD=
