# Generic deployment example. Never put real production secrets here.
APP_NAME=Example Investment API
COMPANY_NAME=Example Investment Company
COMPANY_TAGLINE=Investment services
SERVICE_NAME=investment-api

APP_URL=https://example.com
API_URL=https://api.example.com
UNSUBSCRIBE_URL=https://example.com/unsubscribe

DATABASE_URL=postgresql+asyncpg://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/DATABASE_NAME
JWT_SECRET=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

CORS_ORIGINS=["http://localhost:3000","https://example.com","https://www.example.com"]

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=no-reply@example.com

# Optional initial administrator settings. Configure before running the bootstrap script.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_SUPERADMIN_EMAIL=
# INITIAL_SUPERADMIN_PASSWORD=

# Leave unset unless cookie authentication is introduced and requires it.
# COOKIE_DOMAIN=
